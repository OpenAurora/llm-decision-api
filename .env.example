# Copy to .env if desired; existing process environment takes precedence.
# Upstream server supporting vLLM-style candidate constraints and logprobs
LLM_DECISION_BASE_URL=http://127.0.0.1:8000/v1
# Tested model: Qwen3.8-27B. Use the exact model alias exposed by your server.
LLM_DECISION_MODEL=qwen3.8-27b
LLM_DECISION_API_KEY=replace-with-model-api-key

# Maximum Choice options or Score levels per question: 2..62. Increase only after the upstream
# model service supports the same number of returned logprobs.
LLM_DECISION_MAX_OPTIONS=20
# Cumulative body reception deadline, independent of the decision deadline.
LLM_DECISION_BODY_TIMEOUT_SECONDS=10
# Decision deadline after request validation: input preparation, model calls and answer assembly.
LLM_DECISION_TIMEOUT_SECONDS=10
LLM_DECISION_MAX_BODY_BYTES=1048576

# Verify complete candidate scores for LLM_DECISION_MAX_OPTIONS before accepting traffic.
LLM_DECISION_VERIFY_UPSTREAM_ON_STARTUP=true
# Optional, independent inbound Bearer key. Empty leaves authentication to
# the deployment gateway; the CLI binds to 0.0.0.0:8010 by default.
LLM_DECISION_SERVICE_API_KEY=
LLM_DECISION_LOG_LEVEL=INFO
